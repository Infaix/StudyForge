{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "studyforge",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "studyforge-db",
      "database_id": "d3a604ef-2ba8-401b-862f-b13b98b62290"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "studyforge-tag-cache",
      "database_id": "9e144a9e-53f0-4f85-a390-9f38ded2fcda"
    }
  ]
}
